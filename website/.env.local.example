# Contact form — sends to rankmappro@gmail.com via Gmail SMTP
GMAIL_USER=rankmappro@gmail.com
GMAIL_APP_PASSWORD=your-16-char-google-app-password
CONTACT_TO_EMAIL=rankmappro@gmail.com

# Optional: use Resend instead of Gmail (leave GMAIL_APP_PASSWORD empty)
# RESEND_API_KEY=re_xxxx
# CONTACT_FROM_EMAIL=RankMap Pro <onboarding@resend.dev>

# Admin panel (/admin) — same Supabase project as the extension
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Analytics 4 (production only; /admin excluded)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
